# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

/.venv/

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# environment variables
.env.local

# large ortholog‐alliance files  (keep them out of the repo)
public/data/ORTHOLOGY-ALLIANCE_COMBINED_*.tsv

# build / runtime noise (un-rooted: also catches nested backend & app dirs
# that the rooted /.next/ and /.venv/ above miss)
.next/
__pycache__/
*.pyc
.venv/
*.log