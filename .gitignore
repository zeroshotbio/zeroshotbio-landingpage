# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

/.venv/

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# environment variables
.env.local

# large ortholog‐alliance files  (keep them out of the repo)
public/data/ORTHOLOGY-ALLIANCE_COMBINED_*.tsv

# build / runtime noise (un-rooted: also catches nested backend & app dirs
# that the rooted /.next/ and /.venv/ above miss)
.next/
__pycache__/
*.pyc
.venv/
*.log

# large local data (native atlases + recursive/replay outputs — hundreds of MB,
# must never hit git). Targeted, NOT a blanket daniotype_data/ — that dir also
# holds 400+ tracked curated assets (chemfish/, megafin/) that must stay visible.
daniotype_data/*_native/
daniotype_data/zscape_recursive/
daniotype_data/zscape_commit_gold/
daniotype_data/zscape_flat_v1/
daniotype_data/meta_reasoner_replay/

# intentionally-untracked local config
*.local
# pipeline viz build artefact — regenerate with public/pipeline/build.sh
/public/pipeline/pipeline-standalone.html
.pipeline-daemon/
